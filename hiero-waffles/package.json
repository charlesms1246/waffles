{
  "name": "hiero-waffles",
  "private": false,
  "description": "A developer-experience library for Hiero networks",
  "version": "1.0.6",
  "type": "module",
  "exports": {
    "./core": {
      "import": "./packages/core/dist/index.js",
      "types": "./packages/core/dist/index.d.ts"
    },
    "./mirror-node": {
      "import": "./packages/mirror-node/dist/index.js",
      "types": "./packages/mirror-node/dist/index.d.ts"
    },
    "./scheduled-tx": {
      "import": "./packages/scheduled-tx/dist/index.js",
      "types": "./packages/scheduled-tx/dist/index.d.ts"
    },
    "./react": {
      "import": "./packages/react/dist/index.js",
      "types": "./packages/react/dist/index.d.ts"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "packages/core/dist",
    "packages/mirror-node/dist",
    "packages/scheduled-tx/dist",
    "packages/react/dist"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
