{
  "name": "@hiero-sdk-utils/core",
  "version": "0.1.0",
  "description": "Shared types, errors, and utilities for hiero-sdk-utils",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": ["dist", "src"],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/hiero-sdk-utils.git",
    "directory": "packages/core"
  }
}
