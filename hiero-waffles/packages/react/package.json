  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": ["dist", "src"],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/hiero-waffles.git",
    "directory": "packages/react"
