{
  "name": "hiero-waffles/react",
  "version": "0.1.0",
  "description": "React hooks and provider for Hiero network integration",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
